# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@host/dbname

# OpenAI
OPENAI_API_KEY=sk-...

# Auth
BETTER_AUTH_SECRET=your-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:4173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production URLs
WEB_ORIGIN=http://localhost:4173

# Set API_URL in the web app environment (apps/web/.env.local for local development).
API_URL=http://localhost:4300
# Production: set the same random 32+ character secret on Vercel AND Render.
# This enables signed client-IP forwarding for guest quotas. Never expose publicly.
PROXY_SHARED_SECRET=
# Only needed for a separately configured trusted reverse proxy.
TRUSTED_PROXIES=127.0.0.1,::1
# Only verified email accounts can receive admin access.
ADMIN_EMAILS=
